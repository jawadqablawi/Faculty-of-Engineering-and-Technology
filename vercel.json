{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "ETCS_DEPLOY_PREPARE=1 python manage.py vercel_prepare",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/cron/reminders/",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "config/wsgi.py": {
      "includeFiles": "coordination/**",
      "maxDuration": 60
    }
  }
}
