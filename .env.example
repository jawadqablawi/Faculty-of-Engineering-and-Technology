# Use scripts/prepare_deploy.py to generate .env; never commit real values.
ETCS_DOMAIN=coordination.example.edu
ETCS_DEBUG=0
ETCS_SECRET_KEY=
ETCS_DB_PASSWORD=
ETCS_WEB_DB_PASSWORD=
ETCS_ALLOWED_HOSTS=coordination.example.edu,localhost,127.0.0.1
ETCS_TRUSTED_ORIGINS=https://coordination.example.edu
ETCS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ETCS_EMAIL_HOST=
ETCS_EMAIL_PORT=587
ETCS_EMAIL_USER=
ETCS_EMAIL_PASSWORD=
ETCS_FROM_EMAIL=
ETCS_EMAIL_NOTIFICATIONS=0

# Optional Web Push configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# Optional storage budget and retention preview settings
# ETCS_STORAGE_BUDGET_BYTES=1000000000
# ETCS_MAX_REQUEST_ATTACHMENTS=10
# ETCS_UPLOAD_IMAGE_MAX_EDGE=2400
# ETCS_RETENTION_READ_DAYS=180
# ETCS_RETENTION_DELIVERY_DAYS=90
# ETCS_RETENTION_DRAFT_DAYS=180
